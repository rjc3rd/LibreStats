# LibreStats public folder (Apache). Only this folder should be the web root; lib/, bin/, sql/,
# tests/ and config.php stay outside it.

Options -Indexes

# Let PHP see "Authorization: Bearer …" for the data API (api.php).
CGIPassAuth On

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "no-referrer"
    # The tracking script can be cached for a day; the collector never.
    <Files "s.js">
        Header set Cache-Control "public, max-age=86400"
    </Files>
</IfModule>
